cat << 'EOF' > /etc/init.d/heartbeat_tunnel
#!/bin/sh /etc/rc.common

# File location /etc/init.d/heartbeat_tunnel

START=99
USE_PROCD=1

start_service() {
    procd_open_instance
    # Runs your heartbeat script using the shell
    procd_set_param command /bin/sh /usr/bin/heartbeat_tunnel.sh
    
    # RESPAWN: Auto-restarts the script if it crashes or drops
    procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-0}
    
    # Send all output/errors to system log (logread)
    procd_set_param stdout 1
    procd_set_param stderr 1
    
    procd_close_instance
}
EOF

chmod +x /etc/init.d/heartbeat_tunnel